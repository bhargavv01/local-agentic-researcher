# =================================================================
# Local Multi-Agent AI Research Assistant - Environment Configuration
# =================================================================
# Copy this file to .env and fill in your values as needed.
# .env is ignored by git to keep secrets secure.

# Ollama API Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b

# Critic and DAG Thresholds
CONFIDENCE_THRESHOLD=75
MAX_ITERATIONS=3

# Optional: API Keys (if using proprietary search / LLM providers)
# TAVILY_API_KEY=your_tavily_key_here
# SERPAPI_API_KEY=your_serpapi_key_here
